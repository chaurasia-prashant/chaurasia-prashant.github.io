{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "public/**",
      ".firebaserc",
      "firebase-debug.log"
    ],
    "rewrites": [
      {
        "source": "/auth",
        "destination": "/auth.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
